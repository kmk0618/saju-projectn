# 브라우저에 노출 가능한 값만 NEXT_PUBLIC_ 접두사를 사용합니다.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY

# 아래 비밀키들은 브라우저 코드에 절대 넣지 않습니다.
# OPENAI_API_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
# PORTONE_API_SECRET=
# TOSS_SECRET_KEY=

# 내부 워커 서명 전용 비밀값. 미설정 시 서버 service-role 키를 HMAC에만 사용합니다.
# REPORT_WORKER_SECRET=
# 개발 환경의 관리자 테스트만 허용. production에서는 항상 차단됩니다.
ENABLE_TEST_ORDERS=false
# Windows 로컬 PDF 렌더링에만 필요합니다.
# PDF_CHROME_PATH=C:/Program Files/Google/Chrome/Application/chrome.exe
